# Local backend env for the orchestrator (copy to local/.env — never commit .env).
#
# Run from the project root:
#   deno run --allow-net --allow-env --allow-read=local/storage --allow-write=local/storage --env-file=local/.env supabase/functions/orchestrator/index.ts
#
# Then point the dashboard at it (browser console):
#   localStorage.setItem('_orch_backend', 'http://localhost:8000')

# ── Database: direct Postgres (docker compose -f local/docker-compose.yml up -d)
DB_DRIVER=postgres
DATABASE_URL=postgresql://ucg:ucg_local_dev@localhost:5433/ucg

# ── Backend's own URL: task-step chaining and file links (Deno.serve default port is 8000)
ORCH_SELF_URL=http://localhost:8000

# ── File storage: uploads go to disk and are served at <ORCH_SELF_URL>/files/<bucket>/<name>
# (default driver is supabase = Supabase Storage). The --allow-read/--allow-write
# paths above must match FILE_STORAGE_DIR.
STORAGE_DRIVER=local
FILE_STORAGE_DIR=local/storage

# ── Login: emails that log in as master (comma-separated). Everyone else needs a
# tenant_users row; unknown emails are refused. Set the same variable in production.
MASTER_EMAILS=

# ── Optional: only needed for the OTP email login flow
# GMAIL_APP_PWD=

# LLM provider keys are NOT env vars — they live in the provider_config table.
