# Local backend env for the orchestrator (copy to local/.env — never commit .env).
#
# Run from the project root:
#   deno run --allow-net --allow-env --allow-read --env-file=local/.env supabase/functions/orchestrator/index.ts
#
# Then point the dashboard at it (browser console):
#   localStorage.setItem('_orch_backend', 'http://localhost:8000')

# ── Database: direct Postgres (docker compose -f local/docker-compose.yml up -d)
DB_DRIVER=postgres
DATABASE_URL=postgresql://ucg:ucg_local_dev@localhost:5433/ucg

# ── Self-invoke URL for task-step chaining (Deno.serve default port is 8000)
ORCH_SELF_URL=http://localhost:8000

# ── Optional: only needed for the OTP email login flow
# GMAIL_APP_PWD=

# LLM provider keys are NOT env vars — they live in the provider_config table.
